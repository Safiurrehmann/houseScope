OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
PROJECT_BUDGET_USD=5

# Supabase server-only credentials. Use Transaction pooler, port 6543.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=housescope
# Local defaults to sqlite. Vercel defaults to supabase.
# HOUSESCOPE_STORAGE=supabase
# Optional stable signing key; otherwise derived from SUPABASE_SECRET_KEY.
# HOUSESCOPE_SESSION_SECRET=
# BACKEND_URL is injected by Vercel Services. Do not set it yourself.
